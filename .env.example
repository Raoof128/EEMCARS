# EEMCARS Environment Variables Example
# Copy this file to .env and update with your values

# Application
APP_NAME="Essential Eight Maturity Continuous Assessment & Remediation System"
APP_VERSION="1.0.0"
DEBUG=False
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://eemcars:eemcars123@localhost:5432/eemcars
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Azure Configuration
AZURE_REGION=australiaeast
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_CONTAINER=eemcars-evidence

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Assessment Configuration
ASSESSMENT_SCHEDULE_DEFAULT="0 */6 * * *"
DRIFT_DETECTION_ENABLED=true
EVIDENCE_RETENTION_DAYS=365

# Agent Configuration
AGENT_HEARTBEAT_TIMEOUT_MINUTES=15
AGENT_VERSION_REQUIRED=1.0.0

# Reporting
REPORTS_STORAGE_PATH=/tmp/eemcars/reports
REPORTS_RETENTION_DAYS=90

# Frontend
REACT_APP_API_URL=http://localhost:8000/api/v1

# Demo Mode
DEMO_MODE=false
DEMO_DATA_SEED=true
