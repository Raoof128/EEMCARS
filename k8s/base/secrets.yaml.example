# Example secrets file - DO NOT commit actual secrets
# Use Azure Key Vault or kubectl create secret in production

apiVersion: v1
kind: Secret
metadata:
  name: eemcars-secrets
  namespace: eemcars
type: Opaque
stringData:
  database-url: "postgresql+asyncpg://user:password@host:5432/eemcars"
  secret-key: "change-this-to-a-strong-random-key"
  azure-client-secret: "your-azure-client-secret"
